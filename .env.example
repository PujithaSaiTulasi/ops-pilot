# OpsPilot configuration
# Copy to `.env` and adjust. NEVER commit the real `.env` file.
# All values below are safe defaults for local/simulated use.

# --- Core ---
APP_NAME=OpsPilot
ENVIRONMENT=dev                 # dev | test | prod
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# --- LLM (deterministic mock mode is the default; no API key required) ---
# Leave OPENAI_API_KEY empty to run in mock mode. Never hardcode keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MOCK_LLM=true                   # true = deterministic mock, tests never call OpenAI

# --- Storage ---
# Compose sets DATABASE_URL for Postgres; local dev defaults to SQLite.
DATABASE_URL=sqlite+aiosqlite:///./var/opspilot.db
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot
POSTGRES_DB=opspilot
REDIS_URL=redis://localhost:6379/0

# --- Simulator / investigation controls ---
SCENARIO_DIR=./scenarios
INVESTIGATION_MAX_STEPS=25
APPROVAL_TIMEOUT_SECONDS=900

# --- Observability ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=opspilot
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_ENABLED=true

# --- Guardrails ---
# Side-effecting actions (rollback/restart/deploy/delete/notify) always need
# human approval; this flag additionally gates external notifications.
EXTERNAL_NOTIFICATIONS_ENABLED=false
