# OpsPilot — example environment file.
# Copy to `.env` and adjust. `.env` is gitignored: NEVER commit real credentials.
#   cp .env.example .env
#
# Mock mode is ON by default: no OpenAI API key and no network access are required.

# ── Core ────────────────────────────────────────────────────────────────────
APP_NAME=OpsPilot
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# ── LLM ─────────────────────────────────────────────────────────────────────
# Leave empty for mock mode. Never paste a real key into a committed file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Deterministic mock mode: scripted, reproducible agent behaviour, no network.
MOCK_LLM=true
MOCK_LLM_SEED=7

# ── Storage ─────────────────────────────────────────────────────────────────
# Default: SQLite for zero-dependency local development.
# Docker Compose overrides this with PostgreSQL when set in `.env`.
DATABASE_URL=sqlite+aiosqlite:///./data/opspilot.db
REDIS_URL=redis://localhost:6379/0

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Incident simulator ──────────────────────────────────────────────────────
SCENARIO_DIR=scenarios

# ── Guardrails / human approval ─────────────────────────────────────────────
MAX_INVESTIGATION_STEPS=12
MAX_TOOL_CALLS_PER_STEP=8
TOOL_TIMEOUT_SECONDS=10.0
APPROVAL_TIMEOUT_SECONDS=300
# Side-effecting actions that ALWAYS require explicit human approval.
REQUIRE_APPROVAL_FOR=["rollback", "restart", "deploy", "delete", "notify"]

# ── Observability ───────────────────────────────────────────────────────────
ENABLE_METRICS=true
OTEL_SERVICE_NAME=opspilot
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_EXPORTER=otlp

# ── Docker Compose: local PostgreSQL (development only) ─────────────────────
# Local-only development credentials for the `db` service — not secrets,
# never reuse them anywhere else.
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot
POSTGRES_DB=opspilot
POSTGRES_PORT=5432
