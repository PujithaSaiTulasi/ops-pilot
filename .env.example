# OpsPilot — example environment file.
# Copy to `.env` and adjust. `.env` is gitignored: NEVER commit real credentials.
#   cp .env.example .env
#
# Mock mode needs no OpenAI API key. Redis and trace export use local networking;
# REDIS_URL= and OTEL_TRACES_EXPORTER=none disable those for a one-process demo.

# ── Core ────────────────────────────────────────────────────────────────────
APP_NAME=OpsPilot
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# ── LLM ─────────────────────────────────────────────────────────────────────
# Leave empty for mock mode. Never paste a real key into a committed file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Deterministic mock mode: scripted, reproducible agent behaviour, no network.
MOCK_LLM=true
# Use stdio to run each MCP server as a separate process; tests use in_process.
MCP_TRANSPORT=in_process
MCP_SERVERS_PATH=ops/mcp/servers.json
# Reserved: the current scripted model does not use this seed.
MOCK_LLM_SEED=7

# ── Local service connections ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
SIMULATOR_STATE_PATH=data/simulator.json
PAYMENT_URL=http://localhost:8002
INVENTORY_URL=http://localhost:8003
SERVICE_VERSION=1.0.0

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Incident simulator ──────────────────────────────────────────────────────
SCENARIO_DIR=scenarios

# ── Guardrails / human approval ─────────────────────────────────────────────
MAX_INVESTIGATION_STEPS=12
# Per-step tool count is reserved; tool timeouts are enforced by the agent.
MAX_TOOL_CALLS_PER_STEP=8
TOOL_TIMEOUT_SECONDS=10.0
# Approval expiry is enforced by the approval store and mutating MCP tools.
APPROVAL_TIMEOUT_SECONDS=300
APPROVAL_STORE_PATH=data/approvals.json
AUDIT_LOG_PATH=data/audit.jsonl
# Reserved policy list: runtime classification currently uses tool metadata.
REQUIRE_APPROVAL_FOR=["rollback", "restart", "deploy", "delete", "notify"]

# ── Observability ───────────────────────────────────────────────────────────
# Metrics routes are currently always enabled in the local control plane.
ENABLE_METRICS=true
OTEL_SERVICE_NAME=opspilot
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_EXPORTER=otlp
